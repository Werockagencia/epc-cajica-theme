{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1360px"
    },
    "color": {
      "palette": [
        { "slug": "azul", "name": "Azul (Acueducto)", "color": "#2484c6" },
        { "slug": "azul-hover", "name": "Azul hover", "color": "#1c6ba3" },
        { "slug": "azul-oscuro", "name": "Azul oscuro (Institucional)", "color": "#043956" },
        { "slug": "azul-oscuro-2", "name": "Azul oscuro 2", "color": "#0a5478" },
        { "slug": "verde", "name": "Verde (Aseo)", "color": "#8dc63f" },
        { "slug": "verde-oscuro", "name": "Verde oscuro", "color": "#6ba82c" },
        { "slug": "naranja", "name": "Naranja (Alcantarillado)", "color": "#ef923b" },
        { "slug": "naranja-hover", "name": "Naranja hover", "color": "#e07f22" },
        { "slug": "gris-texto", "name": "Gris texto", "color": "#5b6572" },
        { "slug": "gris-claro", "name": "Gris claro", "color": "#f3f7f6" },
        { "slug": "gris-borde", "name": "Gris borde", "color": "#e2e9e7" },
        { "slug": "blanco", "name": "Blanco", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "base",
          "name": "Manrope",
          "fontFamily": "\"Manrope\", \"Segoe UI\", Arial, Helvetica, sans-serif"
        },
        {
          "slug": "titulo",
          "name": "Poppins",
          "fontFamily": "\"Poppins\", \"Segoe UI\", Arial, Helvetica, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Pequeño", "size": "13px" },
        { "slug": "medium", "name": "Base", "size": "16px" },
        { "slug": "large", "name": "Grande", "size": "22px" },
        { "slug": "x-large", "name": "Extra grande", "size": "34px" },
        { "slug": "xx-large", "name": "Titular", "size": "48px" }
      ]
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vh", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--blanco)",
      "text": "var(--wp--preset--color--azul-oscuro)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--base)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--azul-oscuro)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--azul)" } }
      },
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--titulo)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Encabezado", "area": "header" },
    { "name": "footer", "title": "Pie de página", "area": "footer" }
  ]
}
